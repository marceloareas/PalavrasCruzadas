# Copie para .env.prod e troque TODOS os valores. Nao versione o .env.prod.
# Use senhas so com letras e numeros (vao dentro de uma URL de conexao).
POSTGRES_PASSWORD=troque-esta-senha
MONGO_USER=cruzadinha
MONGO_PASSWORD=troque-esta-senha
# Texto longo e aleatorio, ex.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=troque-por-um-texto-longo-e-aleatorio
# Porta publica da aplicacao
WEB_PORT=80
# true = cria as 4 cruzadas e partidas de exemplo na primeira subida
SEED_EXEMPLOS=false
# --- Integracao com o Ludica ---
# Palavra fixa combinada com o Ludica para o token (hash de gamertag + data + palavra)
LUDICA_SEGREDO=troque-pela-palavra-combinada
# Palavra do token no envio da pontuacao (vazio = a mesma de cima)
LUDICA_SEGREDO_ENVIO=
# URL da API de pontuacao do Ludica (vazio = pontuacoes ficam pendentes)
LUDICA_URL_PONTUACAO=
# id do jogo Cruzadinha no Ludica (opcional, vai junto no envio)
LUDICA_ID_JOGO=
# Numero que o Ludica usa para cada perfil
LUDICA_PERFIL_PROFESSOR=1
LUDICA_PERFIL_ALUNO=2
# Endereco do Ludica (botao "Ir para o Ludica" na tela de entrada)
LUDICA_URL_SITE=
