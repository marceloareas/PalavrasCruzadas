# Copie para .env para rodar a API fora do Docker (bancos no Docker).
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=palavras_cruzadas
MONGO_URL=mongodb://localhost:27017
MONGO_DB=palavras_cruzadas
PORT=3000
SESSION_SECRET=dev-secret-troque-em-producao
NODE_ENV=development
# false = nao cria as cruzadas de exemplo na primeira subida
SEED_EXEMPLOS=true
# --- Integracao com o Ludica (ver src/services/ludica.js) ---
# true = atalhos "entrar como" e simular entrada (padrao: true fora de producao)
LOGIN_DEV=true
# Titulo com que o jogo esta cadastrado no Ludica (vira o NOMEJOGO do hash)
LUDICA_NOME_JOGO=CRUZADINHA
# url_retorno sugerido no simulador (npm run ludica-mock sobe um na porta 4000)
LUDICA_URL_RETORNO_DEV=http://localhost:4000/integracao/resultados
