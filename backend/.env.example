# Copie para .env para rodar a API fora do Docker (bancos no Docker).
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=palavras_cruzadas
MONGO_URL=mongodb://localhost:27017
MONGO_DB=palavras_cruzadas
PORT=3000
SESSION_SECRET=dev-secret-troque-em-producao
NODE_ENV=development
# false = nao cria as cruzadas de exemplo na primeira subida
SEED_EXEMPLOS=true
# --- Integracao com o Ludica (ver src/services/ludica.js) ---
# true = atalhos "entrar como" e gerar link (padrao: true fora de producao)
LOGIN_DEV=true
# Palavra fixa do token (hash de gamertag + data + palavra)
LUDICA_SEGREDO=segredo-dev
# Algoritmo do hash e fuso da data (AAAA-MM-DD)
LUDICA_HASH=sha256
LUDICA_FUSO=America/Sao_Paulo
# Numero que o Ludica usa para cada perfil
LUDICA_PERFIL_PROFESSOR=1
LUDICA_PERFIL_ALUNO=2
# API de pontuacao (npm run ludica-mock sobe uma falsa na porta 4000)
LUDICA_URL_PONTUACAO=http://localhost:4000/pontuacao
LUDICA_SEGREDO_ENVIO=
LUDICA_ID_JOGO=
