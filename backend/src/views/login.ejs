<%- include('partials/head', { titulo: 'Entrar' }) %>
<%- include('partials/nav') %>

<div class="auth-grid">
  <section class="card">
    <h1>Entrar</h1>
    <p class="muted">
      A autenticação é feita pelo <strong>Lúdica</strong>. Para desenvolvimento,
      escolha um usuário já sincronizado para "entrar como".
    </p>

    <% if (erro) { %>
      <div class="alert alert-erro"><%= erro %></div>
    <% } %>

    <form method="post" action="/login" class="stack">
      <label for="id_usuario">Entrar como</label>
      <select id="id_usuario" name="id_usuario" required>
        <optgroup label="Professores">
          <% usuarios.filter(u => u.papel === 'professor').forEach(u => { %>
            <option value="<%= u.id_usuario %>">@<%= u.usertag %> — <%= u.nome %></option>
          <% }) %>
        </optgroup>
        <optgroup label="Alunos">
          <% usuarios.filter(u => u.papel === 'aluno').forEach(u => { %>
            <option value="<%= u.id_usuario %>">@<%= u.usertag %> — <%= u.nome %></option>
          <% }) %>
        </optgroup>
      </select>
      <button class="btn" type="submit">Entrar</button>
    </form>
  </section>

  <section class="card card-muted">
    <h2>Simular payload do Lúdica</h2>
    <p class="muted">
      O Lúdica envia <code>id</code>, <code>usertag</code>, <code>email</code> e
      <code>papel</code>. Este formulário faz o <em>upsert</em> do usuário e já
      autentica (útil para testar novos usuários).
    </p>
    <form method="post" action="/auth/ludica" class="stack">
      <label>id (Lúdica)<input type="number" name="id" value="1003" required></label>
      <label>usertag<input type="text" name="usertag" value="prof.novo" required></label>
      <label>nome<input type="text" name="nome" value="Professor Novo"></label>
      <label>email<input type="email" name="email" value="prof.novo@aluno.cefet-rj.br" required></label>
      <label>papel
        <select name="papel" required>
          <option value="professor">professor</option>
          <option value="aluno">aluno</option>
        </select>
      </label>
      <button class="btn btn-ghost" type="submit">Sincronizar e entrar</button>
    </form>
  </section>
</div>

<%- include('partials/foot') %>
