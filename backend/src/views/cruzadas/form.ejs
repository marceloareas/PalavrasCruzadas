<%- include('../partials/head', { titulo: modo === 'criar' ? 'Nova cruzada' : 'Editar cruzada' }) %>
<%- include('../partials/nav') %>

<div class="page-head">
  <div>
    <p class="muted" style="margin:0"><strong style="color:var(--brand-ink)">Construtor de Palavras Cruzadas</strong></p>
    <h1><%= modo === 'criar' ? 'Novo Desafio Acadêmico' : 'Editar Desafio' %></h1>
  </div>
  <span class="pill pill-ludica">Lúdica Engine</span>
</div>

<% if (modo === 'editar') { %>
  <div class="alert alert-info">
    Salvar a edição cria uma <strong>nova versão</strong>. O histórico das sessões
    já jogadas continua vinculado à versão anterior (RN09).
  </div>
<% } %>

<% if (erros && erros.length) { %>
  <div class="alert alert-erro">
    <strong>Não foi possível salvar. Corrija a grade (RN06):</strong>
    <ul><% erros.forEach(e => { %><li><%= e %></li><% }) %></ul>
  </div>
<% } %>

<form method="post"
      action="<%= modo === 'criar' ? '/cruzadas' : ('/cruzadas/' + idCruzada) %>"
      id="form-cruzada" class="stack">

  <div class="grid-2">
    <label>Título
      <input type="text" name="titulo" value="<%= cruzada.titulo || '' %>" required maxlength="150">
    </label>
    <label>Disciplina (RN04: apenas uma)
      <select name="id_disciplina" required>
        <option value="">— selecione —</option>
        <% disciplinas.forEach(d => { %>
          <option value="<%= d.id_disciplina %>"
            <%= String(cruzada.id_disciplina) === String(d.id_disciplina) ? 'selected' : '' %>>
            <%= d.nome %> (<%= d.codigo %>)
          </option>
        <% }) %>
      </select>
    </label>
  </div>

  <label>Descrição
    <textarea name="descricao" rows="2" maxlength="500"><%= cruzada.descricao || '' %></textarea>
  </label>

  <div class="grid-2">
    <label>Dificuldade (RN07)
      <select name="dificuldade">
        <% ['facil','medio','dificil'].forEach(x => { %>
          <option value="<%= x %>" <%= (cruzada.dificuldade||'facil')===x?'selected':'' %>><%= x %></option>
        <% }) %>
      </select>
    </label>
    <label>Status
      <select name="status">
        <% ['rascunho','publicado','arquivado'].forEach(x => { %>
          <option value="<%= x %>" <%= (cruzada.status||'rascunho')===x?'selected':'' %>><%= x %></option>
        <% }) %>
      </select>
    </label>
  </div>

  <div class="palavras-head">
    <h2>Palavras &amp; Dicas <span class="badge-count" id="contador"><%= palavras.length %> cadastradas</span></h2>
    <button type="button" class="btn btn-sm" id="add-palavra">+ Adicionar ao Grid</button>
  </div>
  <p class="muted" style="margin-top:-4px">Gabarito em MAIÚSCULAS · dica semântica · posição (linha/coluna) e direção.</p>

  <div id="palavras">
    <% palavras.forEach((p, i) => { %>
      <fieldset class="palavra-row">
        <div class="pr-grid">
          <label>Resposta
            <input type="text" name="resposta" value="<%= p.resposta || '' %>" class="in-resposta">
          </label>
          <label>Linha
            <input type="number" name="linha" min="1" value="<%= p.linha || 1 %>" class="in-linha">
          </label>
          <label>Coluna
            <input type="number" name="coluna" min="1" value="<%= p.coluna || 1 %>" class="in-coluna">
          </label>
          <label>Direção
            <select name="direcao" class="in-direcao">
              <option value="horizontal" <%= p.direcao==='horizontal'?'selected':'' %>>horizontal →</option>
              <option value="vertical" <%= p.direcao==='vertical'?'selected':'' %>>vertical ↓</option>
            </select>
          </label>
          <button type="button" class="btn btn-ghost btn-sm remove-palavra" title="Remover">✕</button>
        </div>
        <label>Dica
          <input type="text" name="dica" value="<%= p.dica || '' %>" class="in-dica">
        </label>
      </fieldset>
    <% }) %>
  </div>

  <div class="preview-box">
    <h3>Pré-visualização da grade</h3>
    <p class="muted">Atualiza enquanto você digita. A validação oficial ocorre ao salvar (RN06).</p>
    <div id="preview"></div>
    <div id="preview-msg" class="preview-msg"></div>
  </div>

  <div class="form-actions">
    <a class="btn btn-ghost" href="/cruzadas">✦ Gerar Grid</a>
    <button class="btn" type="submit">
      ▶ <%= modo === 'criar' ? 'Publicar no Lúdica' : 'Salvar nova versão' %>
    </button>
  </div>
</form>

<!-- Template de linha de palavra para o botao "adicionar". -->
<template id="tpl-palavra">
  <fieldset class="palavra-row">
    <div class="pr-grid">
      <label>Resposta<input type="text" name="resposta" class="in-resposta"></label>
      <label>Linha<input type="number" name="linha" min="1" value="1" class="in-linha"></label>
      <label>Coluna<input type="number" name="coluna" min="1" value="1" class="in-coluna"></label>
      <label>Direção
        <select name="direcao" class="in-direcao">
          <option value="horizontal">horizontal →</option>
          <option value="vertical">vertical ↓</option>
        </select>
      </label>
      <button type="button" class="btn btn-ghost btn-sm remove-palavra" title="Remover">✕</button>
    </div>
    <label>Dica<input type="text" name="dica" class="in-dica"></label>
  </fieldset>
</template>

<script src="/js/form.js"></script>
<%- include('../partials/foot', { aba: modo === 'criar' ? 'criar' : 'painel' }) %>
