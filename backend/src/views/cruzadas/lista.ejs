<%- include('../partials/head', { titulo: 'Painel Docente' }) %>
<%- include('../partials/nav') %>

<div class="page-head">
  <div>
    <p class="muted" style="margin:0"><strong style="color:var(--brand-ink)">Painel Docente</strong></p>
    <h1>Olá, <%= usuario.nome ? usuario.nome.split(' ')[0] : usuario.usertag %>! 👋</h1>
    <p class="muted" style="margin:0">DCC — Engenharia de Software</p>
  </div>
  <a class="btn" href="/cruzadas/nova">+ Novo Jogo</a>
</div>

<div class="stat-row">
  <div class="stat">
    <div class="num"><%= stats.jogos_criados %></div>
    <div class="lbl">Jogos Criados</div>
  </div>
  <div class="stat">
    <div class="num"><%= stats.alunos_ativos %></div>
    <div class="lbl">Alunos Ativos</div>
  </div>
  <div class="stat">
    <div class="num ok"><%= stats.media_acertos !== null ? stats.media_acertos + '%' : '—' %></div>
    <div class="lbl">Média Acertos</div>
  </div>
</div>

<div class="page-head" style="margin-bottom:12px">
  <h2 style="margin:0">Jogos da Turma</h2>
  <span class="muted">Total (<%= cruzadas.length %>)</span>
</div>

<% if (cruzadas.length === 0) { %>
  <div class="alert">Você ainda não criou nenhum jogo. Clique em "+ Novo Jogo".</div>
<% } else { %>
  <% cruzadas.forEach(c => { %>
    <div class="game-card">
      <div class="gc-top">
        <span class="pill pill-status pill-<%= c.status %>"><%= c.status %></span>
        <% if (c.codigo_acesso) { %><span class="code-tag">🔑 <%= c.codigo_acesso %></span><% } %>
      </div>
      <h3><a href="/cruzadas/<%= c.id_cruzada %>"><%= c.titulo %></a></h3>
      <div class="gc-meta">
        <span>
          <%= c.resolucoes %> resoluç<%= c.resolucoes == 1 ? 'ão' : 'ões' %>
          <% if (c.tempo_medio) { %> · Média <%= Math.floor(c.tempo_medio/60) %>m<%= String(c.tempo_medio%60).padStart(2,'0') %>s<% } %>
          · <%= c.total_palavras %> quest<%= c.total_palavras == 1 ? 'ão' : 'ões' %>
        </span>
        <a href="/cruzadas/<%= c.id_cruzada %>/editar">Editar ✎</a>
      </div>
    </div>
  <% }) %>
<% } %>

<%- include('../partials/foot', { aba: 'painel' }) %>
