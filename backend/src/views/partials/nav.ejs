      <span class="brand-mark" aria-hidden="true">
        <span></span><span></span><span></span><span></span>
      </span>
      <span class="brand-text">
        Cruzadinha Digital
        <small>● Engenharia &amp; Tech</small>
      </span>
    </a>
    <nav class="topnav">
      <% if (usuario) { %>
        <span class="pill pill-<%= usuario.papel %>">
