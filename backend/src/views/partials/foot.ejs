  </main>
  <% if (usuario) { %>
    <nav class="bottomnav">
      <a href="/" class="<%= (typeof aba !== 'undefined' && aba === 'inicio') ? 'ativo' : '' %>">
        <span class="bn-ico">🏠</span>Início
      </a>
      <a href="/cruzadas" class="<%= (typeof aba !== 'undefined' && aba === 'painel') ? 'ativo' : '' %>">
        <span class="bn-ico">📋</span>Painel
      </a>
      <% if (usuario.papel === 'professor') { %>
        <a href="/cruzadas/nova" class="bn-criar <%= (typeof aba !== 'undefined' && aba === 'criar') ? 'ativo' : '' %>">
          <span class="bn-ico">➕</span>Criar
        </a>
      <% } %>
      <a href="#" class="disabled"><span class="bn-ico">🎮</span>Jogar</a>
      <a href="#" class="disabled"><span class="bn-ico">🏆</span>Ranking</a>
    </nav>
  <% } %>
  <footer class="footer">
    <span>Projeto acadêmico · CEFET-RJ · Cruzadinha Digital (v1)</span>
  </footer>
</body>
</html>
